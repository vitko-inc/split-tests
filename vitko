#!/usr/bin/env python3
"""vitko: command-line tools for Vitko products, one subcommand group per product.

Today: `vitko runners split-tests [options] -- <test command>` (alias: `vitko split-tests`).
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from vitko_split.cli import main as split_tests  # noqa: E402

# (words that name a command) -> entry point. Aliases are just more rows.
COMMANDS = {
    ("runners", "split-tests"): split_tests,
    ("split-tests",): split_tests,
}
USAGE = "usage: vitko runners split-tests [options] -- <test command>"


def dispatch(words):
    for name, entry in sorted(COMMANDS.items(), key=lambda item: -len(item[0])):
        if tuple(words[:len(name)]) == name:
            return entry(["split-tests"] + words[len(name):])
    print(USAGE, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(dispatch(sys.argv[1:]))
